# Variables opcionales (todas tienen valor por defecto en docker-compose.yml). Copiar a .env para cambiarlas.

# LLM local (respaldo de la extracción del parte). Cambiarlo requiere reconstruir la imagen de ollama.
LLM_MODELO=qwen3.5:2b

# Control por nota
TIMEOUT_NOTA_S=180
MAX_INTENTOS_BORRADOR=3
MAX_PASOS_LLM_POR_NOTA=4
MAX_TOKENS_POR_NOTA=12000
LLM_TIMEOUT_S=45
